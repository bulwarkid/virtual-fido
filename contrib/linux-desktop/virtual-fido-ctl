#!/usr/bin/env bash
set -euo pipefail

# Resolve the target desktop user even when invoked under `sudo`
TARGET_USER="${SUDO_USER:-$(id -un)}"
TARGET_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6 || true)"
if [ -z "$TARGET_HOME" ]; then
    TARGET_HOME="/home/$TARGET_USER"
fi

XDG_CFG="${XDG_CONFIG_HOME:-$TARGET_HOME/.config}"
CONFIG_DIR="${VIRTUAL_FIDO_CONFIG_DIR:-$XDG_CFG/virtual-fido}"
SEED_FILE="$CONFIG_DIR/seed.hex"
PID_FILE="$CONFIG_DIR/virtual-fido.pid"
HOTKEY_PID_FILE="$CONFIG_DIR/virtual-fido-hotkey.pid"
LOG_FILE="$CONFIG_DIR/virtual-fido.log"
HOTKEY_LOG_FILE="$CONFIG_DIR/virtual-fido-hotkey.log"
SIGNAL_FILE="$CONFIG_DIR/touch.sig"
FIFO_FILE="$CONFIG_DIR/touch.fifo"
DEVICE_NAME="${VIRTUAL_FIDO_DEVICE_NAME:-Virtual FIDO}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${VIRTUAL_FIDO_BIN:-$(command -v virtual-fido 2>/dev/null || echo "$TARGET_HOME/.local/bin/virtual-fido")}"
if [ -x "$SCRIPT_DIR/virtual-fido-hotkey" ]; then
    HOTKEY_BIN="${VIRTUAL_FIDO_HOTKEY_BIN:-$SCRIPT_DIR/virtual-fido-hotkey}"
else
    HOTKEY_BIN="${VIRTUAL_FIDO_HOTKEY_BIN:-$(command -v virtual-fido-hotkey 2>/dev/null || echo "$TARGET_HOME/.local/bin/virtual-fido-hotkey")}"
fi

mkdir -p "$CONFIG_DIR"
chmod 0700 "$CONFIG_DIR"
if [ "$(id -u)" -eq 0 ] && [ "$TARGET_USER" != "root" ]; then
    chown "$TARGET_USER:$TARGET_USER" "$CONFIG_DIR"
fi

supports_uhid_cli() {
    "$BIN" --help 2>&1 | grep -q "gen-seed" || "$BIN" run --help >/dev/null 2>&1
}

ensure_uhid_access() {
    if [ -r /dev/uhid ] && [ -w /dev/uhid ]; then
        return 0
    fi
    echo "Configuring /dev/uhid kernel module and plugdev permissions..."
    local rules_content
    rules_content='# Allow plugdev group and active local desktop sessions to access /dev/uhid and FIDO hidraw nodes
KERNEL=="uhid", SUBSYSTEM=="misc", GROUP="plugdev", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", GROUP="plugdev", MODE="0660", TAG+="uaccess"'
    if [ "$(id -u)" -eq 0 ]; then
        modprobe uhid || true
        printf 'uhid\n' > /etc/modules-load.d/uhid.conf
        printf '%s\n' "$rules_content" > /etc/udev/rules.d/70-virtual-fido-uhid.rules
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=misc --subsystem-match=hidraw || true
        chgrp plugdev /dev/uhid && chmod 0660 /dev/uhid
    else
        sudo sh -c "
            modprobe uhid || true
            printf 'uhid\n' > /etc/modules-load.d/uhid.conf
            cat > /etc/udev/rules.d/70-virtual-fido-uhid.rules <<'EOF'
$rules_content
EOF
            udevadm control --reload-rules || true
            udevadm trigger --subsystem-match=misc --subsystem-match=hidraw || true
            chgrp plugdev /dev/uhid && chmod 0660 /dev/uhid
        "
    fi
}

start_hotkey_daemon() {
    if [ ! -x "$HOTKEY_BIN" ]; then
        return 0
    fi
    if [ -f "$HOTKEY_PID_FILE" ] && kill -0 "$(cat "$HOTKEY_PID_FILE")" 2>/dev/null; then
        return 0
    fi
    if [ "$(id -u)" -eq 0 ] && [ "$TARGET_USER" != "root" ]; then
        sudo -u "$TARGET_USER" DISPLAY="${DISPLAY:-:0}" setsid nohup "$HOTKEY_BIN" "$SIGNAL_FILE" </dev/null > "$HOTKEY_LOG_FILE" 2>&1 &
        HPID=$!
        echo "$HPID" > "$HOTKEY_PID_FILE"
        chown "$TARGET_USER:$TARGET_USER" "$HOTKEY_PID_FILE" "$HOTKEY_LOG_FILE" 2>/dev/null || true
    else
        DISPLAY="${DISPLAY:-:0}" setsid nohup "$HOTKEY_BIN" "$SIGNAL_FILE" </dev/null > "$HOTKEY_LOG_FILE" 2>&1 &
        HPID=$!
        echo "$HPID" > "$HOTKEY_PID_FILE"
    fi
}

stop_hotkey_daemon() {
    if [ -f "$HOTKEY_PID_FILE" ]; then
        HPID="$(cat "$HOTKEY_PID_FILE")"
        if kill -0 "$HPID" 2>/dev/null; then
            kill "$HPID" 2>/dev/null || true
        fi
        rm -f "$HOTKEY_PID_FILE"
    fi
}

cmd="${1:-status}"

case "$cmd" in
    start)
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            start_hotkey_daemon
            echo "virtual-fido is already running (PID $(cat "$PID_FILE"))."
            exit 0
        fi
        if [ ! -x "$BIN" ]; then
            echo "Error: virtual-fido binary not found at $BIN (set VIRTUAL_FIDO_BIN)." >&2
            exit 1
        fi
        shift || true
        EXTRA_FLAGS=()
        for arg in "$@"; do
            if [ "$arg" = "--always-approve" ]; then
                EXTRA_FLAGS+=("--always-approve")
            fi
        done

        if supports_uhid_cli; then
            if [ ! -f "$SEED_FILE" ]; then
                umask 0077
                "$BIN" gen-seed > "$SEED_FILE"
                chmod 0600 "$SEED_FILE"
                if [ "$(id -u)" -eq 0 ] && [ "$TARGET_USER" != "root" ]; then
                    chown "$TARGET_USER:$TARGET_USER" "$SEED_FILE"
                fi
            fi
            ensure_uhid_access
            rm -f "$FIFO_FILE"
            if [ "$(id -u)" -eq 0 ] && [ "$TARGET_USER" != "root" ]; then
                sudo -u "$TARGET_USER" setsid nohup "$BIN" run \
                    --transport uhid \
                    --seed-file "$SEED_FILE" \
                    --signal-file "$SIGNAL_FILE" \
                    --device-name "$DEVICE_NAME" \
                    "${EXTRA_FLAGS[@]}" </dev/null > "$LOG_FILE" 2>&1 &
                PID=$!
            else
                setsid nohup "$BIN" run \
                    --transport uhid \
                    --seed-file "$SEED_FILE" \
                    --signal-file "$SIGNAL_FILE" \
                    --device-name "$DEVICE_NAME" \
                    "${EXTRA_FLAGS[@]}" </dev/null > "$LOG_FILE" 2>&1 &
                PID=$!
            fi
        else
            # Fallback for USB/IP stdin-approval builds (`cmd/demo start`)
            rm -f "$FIFO_FILE"
            mkfifo -m 0600 "$FIFO_FILE"
            if [ "$(id -u)" -eq 0 ] && [ "$TARGET_USER" != "root" ]; then
                chown "$TARGET_USER:$TARGET_USER" "$FIFO_FILE"
            fi
            setsid nohup sh -c 'tail -f /dev/null > "$1" & exec "$2" start < "$1"' _ "$FIFO_FILE" "$BIN" > "$LOG_FILE" 2>&1 &
            PID=$!
        fi

        echo "$PID" > "$PID_FILE"
        if [ "$(id -u)" -eq 0 ] && [ "$TARGET_USER" != "root" ]; then
            chown "$TARGET_USER:$TARGET_USER" "$PID_FILE" "$LOG_FILE" 2>/dev/null || true
        fi
        start_hotkey_daemon
        sleep 0.4
        if kill -0 "$PID" 2>/dev/null; then
            echo "virtual-fido started (PID $PID)."
            echo "Touch approval hotkeys active: Ctrl+CapsLock and Ctrl+F12"
            echo "Logs: $LOG_FILE"
        else
            echo "virtual-fido failed to start. Last log lines:" >&2
            tail -n 10 "$LOG_FILE" >&2 || true
            rm -f "$PID_FILE" "$FIFO_FILE"
            exit 1
        fi
        ;;

    stop)
        stop_hotkey_daemon
        if [ -f "$PID_FILE" ]; then
            PID="$(cat "$PID_FILE")"
            if kill -0 "$PID" 2>/dev/null; then
                kill "$PID" 2>/dev/null || true
                sleep 0.3
            fi
            rm -f "$PID_FILE" "$FIFO_FILE"
            echo "virtual-fido stopped."
        else
            rm -f "$FIFO_FILE"
            echo "virtual-fido is not running."
        fi
        ;;

    restart)
        "$0" stop
        "$0" start "$@"
        ;;

    touch|approve)
        python3 "$HOTKEY_BIN" --once "$SIGNAL_FILE" 2>/dev/null || {
            umask 0077
            printf 'touch\n' > "$SIGNAL_FILE"
            if [ -p "$FIFO_FILE" ]; then
                printf 'y\n' > "$FIFO_FILE" || true
            fi
        }
        echo "Sent touch approval signal ($SIGNAL_FILE)."
        ;;

    status)
        echo "=== Virtual FIDO Status ==="
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            echo "Daemon: RUNNING (PID $(cat "$PID_FILE"))"
        else
            echo "Daemon: STOPPED"
        fi
        if [ -f "$HOTKEY_PID_FILE" ] && kill -0 "$(cat "$HOTKEY_PID_FILE")" 2>/dev/null; then
            echo "Hotkey helper: RUNNING (PID $(cat "$HOTKEY_PID_FILE"))"
        else
            echo "Hotkey helper: STOPPED"
        fi
        ;;

    *)
        echo "Usage: $(basename "$0") {start [--always-approve]|stop|restart|touch|approve|status}" >&2
        exit 2
        ;;
esac
